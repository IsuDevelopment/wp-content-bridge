{
  "name": "isudev/wp-content-bridge",
  "description": "Provider-neutral WordPress content and SEO abilities for MCP and other agent clients.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0",
    "szepeviktor/phpstan-wordpress": "^2.0.4",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "IsuDev\\WPContentBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IsuDev\\WPContentBridge\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit"
  }
}
